---
import { CATEGORIES, OTHER_CATEGORY } from "../lib/format";

interface Props {
  counts: Record<string, number>;
  relevantes: number;
  total: number;
}
const { counts, relevantes, total } = Astro.props;
const cats = [...CATEGORIES.map((c) => ({ id: c.id, label: c.label })), { id: OTHER_CATEGORY.id, label: OTHER_CATEGORY.label }].filter((c) => (counts[c.id] ?? 0) > 0);
---

<section class="filters container" aria-label="Filtros">
  <div class="row">
    <label class="toggle">
      <input type="checkbox" id="only-relevant" checked />
      <span>Solo lo que afecta a grupos amplios o a la mayoría</span>
      <span class="count mono">{relevantes} de {total}</span>
    </label>
  </div>
  <div class="chips" role="group" aria-label="Categorías">
    {cats.map((c) => (
      <button type="button" class="chip" data-cat={c.id} aria-pressed="false">
        {c.label}
        <span class="count mono">{counts[c.id]}</span>
      </button>
    ))}
    <button type="button" class="chip clear" id="clear-cats" hidden>Quitar categorías</button>
  </div>
</section>

<style>
  .filters {
    padding-block: 22px 8px;
  }
  .row {
    margin-bottom: 14px;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    cursor: pointer;
    user-select: none;
  }
  .toggle input {
    appearance: none;
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background: var(--line-strong);
    position: relative;
    margin: 0;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .toggle input::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    transition: transform 0.15s ease;
  }
  .toggle input:checked {
    background: var(--accent);
  }
  .toggle input:checked::after {
    transform: translateX(14px);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    display: inline-flex;
    gap: 7px;
    align-items: baseline;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .chip:hover {
    border-color: var(--fg-muted);
  }
  .chip:active {
    transform: translateY(1px);
  }
  .chip[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .chip[aria-pressed="true"] .count {
    color: inherit;
    opacity: 0.8;
  }
  .chip[hidden] {
    display: none;
  }
  .chip.clear {
    border-style: dashed;
    color: var(--fg-muted);
  }
  .count {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
</style>
